# Copy this file to .env and adjust as needed. Values below match what
# `docker compose up` uses; only DATABASE_URL/REDIS_URL/JWT_SECRET are
# actually required -- everything else has a sane default (see
# src/sentinel/config.py).

# --- Required --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-real-secret

# --- Optional (defaults shown) ---------------------------------------------
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

EMAIL_VERIFICATION_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30

LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

REGISTER_RATE_LIMIT=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=60

FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# "console" (default) logs verification/reset emails instead of sending
# them. Set to "smtp" to actually deliver mail, and fill in the SMTP_* settings below.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@sentinel.local

# Where verification/reset links point. This should be your frontend's
# URL, not this API's -- the frontend page reads the token from the query
# string and calls the API itself.
FRONTEND_URL=http://localhost:3000

# Only used when EMAIL_BACKEND=smtp. Works with any SMTP provider
# (Mailgun, Postmark, SES, a Gmail app password, a local Mailpit/MailHog
# instance for testing against a real inbox, ...).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

