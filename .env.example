# Copy this file to .env and adjust as needed. `docker compose up` also reads
# JWT_SECRET from .env. Only DATABASE_URL, REDIS_URL and JWT_SECRET are
# required; everything else has a default (see src/sentinel/config.py).

# --- Required --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379
# At least 32 characters, or the app refuses to start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Tokens and sessions (defaults shown) ----------------------------------
JWT_ALGORITHM=HS256
JWT_ISSUER=sentinel
JWT_AUDIENCE=sentinel-api

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Absolute cap on a session's life, however often it is refreshed.
SESSION_ABSOLUTE_LIFETIME_DAYS=90
# Revoked sessions are kept this long before being purged.
SESSION_RETENTION_DAYS=7
SESSION_PURGE_INTERVAL_SECONDS=3600

EMAIL_VERIFICATION_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Rate limiting and lockout ---------------------------------------------
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Failed logins before a given (email, client IP) pair is locked out.
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_DURATION_SECONDS=900

REGISTER_RATE_LIMIT=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=60

FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=60

RESEND_VERIFICATION_RATE_LIMIT=5
RESEND_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For header is
# trusted. Leave empty if the app is not behind a proxy (header is ignored).
# TRUSTED_PROXIES=10.0.0.0/8

# --- HTTP ------------------------------------------------------------------
# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Audit logs hash email addresses unless this is true.
LOG_PII=false

# --- Email -----------------------------------------------------------------
# "smtp" delivers real mail (fill in SMTP_* below). "console" only logs the
# message, including verification/reset links, and is refused unless
# ALLOW_CONSOLE_EMAIL=true -- development only.
EMAIL_BACKEND=console
ALLOW_CONSOLE_EMAIL=false
EMAIL_FROM=no-reply@sentinel.local
EMAIL_SEND_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY_SECONDS=1.0

# Where verification/reset links point. This should be your frontend's
# URL, not this API's -- the frontend page reads the token from the query
# string and calls the API itself.
FRONTEND_URL=http://localhost:3000

# Only used when EMAIL_BACKEND=smtp.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true